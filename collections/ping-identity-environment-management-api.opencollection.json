{
  "opencollection": "1.0.0",
  "info": {
    "name": "PingOne Platform Configuration Management Environment Management API",
    "version": "2026.01.07-beta"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environment Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getFlowPolicyById",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingone.{tld}/{basePath}/environments/:environmentID/flowPolicies/:flowPolicyID",
            "headers": [
              {
                "name": "X-Ping-External-Session-ID",
                "value": ""
              },
              {
                "name": "X-Ping-External-Transaction-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "environmentID",
                "value": "",
                "type": "path"
              },
              {
                "name": "flowPolicyID",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}